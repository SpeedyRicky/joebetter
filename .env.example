# Groq API keys. Add up to 20; Gret rotates through them and, when one hits its
# rate limit or daily quota, moves on to the next. When all are used up Gret shows
# an "unavailable" message until a key's limit resets.
GROQ_API_KEY_1="MY_GROQ_KEY_1"
GROQ_API_KEY_2="MY_GROQ_KEY_2"
GROQ_API_KEY_3="MY_GROQ_KEY_3"
GROQ_API_KEY_4="MY_GROQ_KEY_4"
GROQ_API_KEY_5="MY_GROQ_KEY_5"

# Optional model overrides (defaults shown)
# GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_FAST_MODEL="llama-3.1-8b-instant"
# GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
# GROQ_SEARCH_MODEL="groq/compound-mini"

# Optional: restrict which websites may call the API (comma-separated). Empty = any.
# ALLOWED_ORIGINS="https://gret-gpt.vercel.app"

# Website only (set in Vercel): URL of the API server on Render.
# VITE_API_URL="https://your-service.onrender.com"
